# Локальная инфраструктура. Скопируйте в .env; замените ВСЕ CHANGE_ME.
# Значения не являются рабочими секретами. Не используйте реальные медицинские данные.
COMPOSE_PROJECT_NAME=medical-ai
APP_ENV=development
API_PORT=8000
AUTH_ORIGIN=http://localhost:3000
# Set true with HTTPS; production refuses insecure auth configuration.
AUTH_COOKIE_SECURE=false
AUTH_SESSION_SECONDS=28800
FRONTEND_PORT=3000
POSTGRES_DB=medical_ai
POSTGRES_USER=medical_ai
POSTGRES_PASSWORD=CHANGE_ME_APP_DB_PASSWORD
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
MINIO_ROOT_USER=medical_ai_admin
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_ROOT_PASSWORD
MINIO_CONSOLE_PORT=9001
# Stage 3.1: optional until document storage is explicitly used/provisioned.
DOCUMENTS_S3_ENDPOINT=minio:9000
DOCUMENTS_S3_SECURE=false
DOCUMENTS_S3_BUCKET=medical-ai-documents
DOCUMENTS_S3_ACCESS_KEY=medical_ai_documents
DOCUMENTS_S3_SECRET_KEY=CHANGE_ME_DOCUMENTS_S3_SECRET
DOCUMENTS_S3_REGION=us-east-1
DOCUMENTS_MAX_BYTES=20971520
DOCUMENTS_MAX_PAGES=200
DOCUMENTS_MAX_TEXT_CHARS=1000000
DOCUMENTS_PROCESSING_SECONDS=60
DOCUMENTS_MAX_UNPACKED_BYTES=83886080
DOCUMENTS_MAX_ATTEMPTS=3
DOCUMENTS_MAX_VERSIONS=5
DOCUMENTS_MAX_ACTIVE=10
DOCUMENTS_MAX_PER_USER=1000
DOCUMENTS_UPLOAD_GRACE_SECONDS=300
DOCUMENTS_OUTBOX_INTERVAL=5
DOCUMENTS_OUTBOX_ENABLED=true
# Stage 4: enable only after backup, migration 0003 and explicit local model download.
RAG_ENABLED=false
RAG_CHUNK_CHARS=1200
RAG_CHUNK_OVERLAP=200
RAG_OLLAMA_URL=http://ollama:11434
RAG_EMBEDDING_MODEL=bge-m3:567m
# Full model digest from /api/tags; set before first indexing for reproducibility.
RAG_EMBEDDING_DIGEST=
RAG_EMBEDDING_DIMENSIONS=1024
RAG_EMBEDDING_BATCH_SIZE=8
RAG_HTTP_TIMEOUT=60
RAG_INDEX_SECONDS=900
RAG_MAX_ATTEMPTS=5
RAG_QDRANT_URL=http://qdrant:6333
RAG_COLLECTION=medical_ai_personal_v1
# Empty for the existing internal Qdrant. Set only if server authentication is configured.
RAG_QDRANT_API_KEY=
RAG_SEARCH_MAX_K=20
MLFLOW_PORT=5000
MLFLOW_DB=mlflow
MLFLOW_DB_USER=mlflow
MLFLOW_DB_PASSWORD=CHANGE_ME_MLFLOW_DB_PASSWORD
MLFLOW_ARTIFACT_BUCKET=mlflow-artifacts
# Отдельный MinIO user с ограниченной policy создаётся init-сервисом.
MLFLOW_S3_ACCESS_KEY=medical_ai_mlflow
MLFLOW_S3_SECRET_KEY=CHANGE_ME_MLFLOW_S3_SECRET
AWS_DEFAULT_REGION=us-east-1
MLFLOW_S3_ENDPOINT_URL=http://minio:9000
# Внутренние URI для будущих backend/worker клиентов (SDK пока не установлен).
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_REGISTRY_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=medical-ai-development
MLFLOW_TRACING_ENABLED=false
# Не использовать '*' и не отключать security middleware.
MLFLOW_SERVER_ALLOWED_HOSTS=localhost:5000,127.0.0.1:5000,mlflow:5000
MLFLOW_SERVER_CORS_ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
# S3/DB endpoint и параметры приложения внутри Docker фиксированы compose.yaml.
# Для SDK с хоста: MLFLOW_TRACKING_URI=http://localhost:5000
# При изменении MLFLOW_PORT обновить также allowed hosts и origins выше.
